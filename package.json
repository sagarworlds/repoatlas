{
  "name": "repoatlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @repoatlas/api --filter @repoatlas/web dev",
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "pnpm --filter @repoatlas/web build && tsx scripts/build-api.ts",
    "bundle": "tsx scripts/make-deploy-bundle.ts",
    "analyze": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
