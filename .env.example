PORT=4000                     # in production HTTP_PLATFORM_PORT takes precedence
DATA_DIR=./data               # relative paths resolve against the repo root, not cwd
GITHUB_TOKEN=                 # optional, raises GitHub API rate limit
ANALYSIS_CONCURRENCY=2
MAX_TARBALL_BYTES=209715200   # 200 MB
MAX_FILES=20000
MAX_FILE_BYTES=1048576        # 1 MB
ANALYSIS_TIMEOUT_MS=600000    # 10 min
CACHE_MAX_ANALYSES=200
LOG_LEVEL=info                # fatal|error|warn|info|debug|trace|silent
CORS_ORIGIN=http://localhost:5173   # the single allowed browser origin
TRUST_PROXY=false             # hop count behind a proxy (IIS/ARR: 1), "loopback", or false. Never "true".
RATE_LIMIT_ANALYSES_MAX=10    # POST /api/analyses per IP per window
RATE_LIMIT_ANALYSES_WINDOW_MS=3600000
RATE_LIMIT_GENERAL_MAX=300    # all other requests per IP per window
RATE_LIMIT_GENERAL_WINDOW_MS=60000
WEB_DIST_DIR=                 # built frontend; default apps/web/dist (served only if it exists)
EXIT_ON_STDIN_CLOSE=          # default: on when HTTP_PLATFORM_PORT is set (IIS)

# Tree-sitter files (set automatically by the deploy bundle; override for custom layouts)
# GRAMMAR_DIR=
# TREE_SITTER_WASM_DIR=
# PYTHON_QUERIES_DIR=
